.PHONY: build run debug install test e2e release lint

test:
	go test ./...

# e2e needs the network (it fetches mjolnir at latest) and, for the layer-rule
# check, golangci-lint on PATH.
e2e:
	go test -tags e2e -count=1 ./...

lint:
	golangci-lint run

build: lint test
run-ivaldi:
	go run cmd/ivaldi/main.go

run: run-ivaldi

debug:
	go run -race cmd/ivaldi/main.go &
	wait

install:
	go install ./cmd/ivaldi

release: build
	# TODO: Add your release steps or integration with goreleaser here
	echo "Release complete."
